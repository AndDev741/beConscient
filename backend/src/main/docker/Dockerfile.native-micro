####
# The production image: the native executable on a micro base image.
#
# Build the executable first (no local GraalVM needed):
#
#   ./mvnw package -Dnative -Dquarkus.native.container-build=true
#
# then the image:
#
#   docker build -f src/main/docker/Dockerfile.native-micro -t beconscient-backend .
#
# Run it with the production environment (see README.md):
#
#   docker run -p 8080:8080 --env-file prod.env beconscient-backend
#
# The image holds no secret. Without BECONSCIENT_SESSION_KEY,
# BECONSCIENT_OWNER_PASSWORD and BECONSCIENT_HPKE_KEYS it refuses to start.
###
FROM quay.io/quarkus/ubi9-quarkus-micro-image:2.0
WORKDIR /work/
RUN chown 1001 /work \
    && chmod "g+rwX" /work \
    && chown 1001:root /work
COPY --chown=1001:root --chmod=0755 target/*-runner /work/application

EXPOSE 8080
USER 1001

ENTRYPOINT ["./application", "-Dquarkus.http.host=0.0.0.0"]

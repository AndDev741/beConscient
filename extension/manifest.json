{
  "manifest_version": 3,
  "name": "beConscient",
  "version": "0.1.0",
  "description": "Measures time on YouTube and LinkedIn for the beConscient desktop agent. Sends no URLs.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "storage", "alarms"],
  "host_permissions": ["https://www.youtube.com/*", "https://www.linkedin.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/youtube.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content/linkedin.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "beConscient",
    "default_popup": "popup/popup.html"
  }
}
